# Copy to backend/.env. Existing environment variables take precedence.
# Optional absolute path; defaults to the repository data/ directory.
# DATA_DIR=C:/path/to/platform-data

# Amazon Bedrock is the default provider. Use deterministic only for offline demos.
MODEL_PROVIDER=bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Full course authoring uses Nova Pro by default for longer structured content.
BEDROCK_COURSE_MODEL_ID=amazon.nova-pro-v1:0
# Supply a Bedrock API key locally, or use the standard AWS profile/credential chain.
AWS_BEARER_TOKEN_BEDROCK=
# AWS_PROFILE=your-profile

# Leave empty to disable the optional Chroma integration.
CHROMA_HOST=
CHROMA_PORT=8001
